:root
  color-scheme light
  --bg #f7f5f0
  --text #222222
  --muted #6f6a61
  --line #ddd6c9
  --accent #0f766e
  --panel #ffffff

*
  box-sizing border-box

body
  margin 0
  background var(--bg)
  color var(--text)
  font-family -apple-system, BlinkMacSystemFont, "Segoe UI", "Noto Sans SC", sans-serif
  line-height 1.72

a
  color var(--accent)
  text-decoration none

a:hover
  text-decoration underline

.container
  width calc(100% - 32px)
  max-width 920px
  margin 0 auto

.site-header
  border-bottom 1px solid var(--line)
  background rgba(247, 245, 240, 0.92)

.header-inner
  min-height 72px
  display flex
  align-items center
  justify-content space-between
  gap 24px

.site-title
  color var(--text)
  font-size 22px
  font-weight 700

.site-nav
  display flex
  gap 18px
  flex-wrap wrap

.site-nav a
  color var(--muted)
  font-size 15px

main.container
  padding 56px 0 72px

.post-list
  display grid
  gap 28px

.post-item,
.post
  background var(--panel)
  border 1px solid var(--line)
  border-radius 8px
  padding clamp(24px, 4vw, 40px)

.post-item time,
.post-header time,
.archive-item time
  color var(--muted)
  font-size 14px

h1
  margin 8px 0 18px
  font-size clamp(28px, 5vw, 42px)
  line-height 1.2
  letter-spacing 0

.post-item h1
  font-size clamp(24px, 4vw, 34px)

.post-item h1 a
  color var(--text)

.excerpt
  color #3c3832

.post-content
  font-size 17px

.post-content img
  max-width 100%
  height auto
  border-radius 6px

.post-content pre
  overflow auto
  padding 16px
  border-radius 6px
  background #282c34
  color #f8f8f2

.archive h1
  margin-top 0

.archive-item
  display grid
  grid-template-columns 120px 1fr
  gap 20px
  padding 14px 0
  border-bottom 1px solid var(--line)

.pagination
  margin-top 32px
  display flex
  gap 12px
  justify-content center

.pagination a,
.pagination span
  padding 8px 12px
  border 1px solid var(--line)
  border-radius 6px
  background var(--panel)

.site-footer
  border-top 1px solid var(--line)
  color var(--muted)
  font-size 14px

.site-footer .container
  min-height 72px
  display flex
  align-items center
  justify-content space-between
  gap 16px

@media (max-width: 640px)
  .header-inner,
  .site-footer .container
    align-items flex-start
    flex-direction column
    justify-content center
    padding 18px 0

  .archive-item
    grid-template-columns 1fr
    gap 4px
